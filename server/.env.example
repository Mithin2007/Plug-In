# Server runtime
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173
# Keep true for the in-memory, seeded hackathon demo API.
DEMO_MODE=true

# Reserved for the production Supabase adapter. They are intentionally optional
# because this server runs without Supabase during the live demo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
