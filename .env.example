# Copy this file to .env at the repository root for tools that read root variables.
# The frontend and API each load their own environment file; see README.md.

# Browser-safe Supabase configuration (Vite exposes only variables beginning with VITE_).
# Leave these empty to use the built-in demo fallback instead of Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API base URL used by the web client.
VITE_API_URL=http://localhost:4000/api

# API server configuration. Never expose this value to the browser.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly keeps the product usable without remote credentials. Set to false when
# a deployed Supabase project and API are available.
DEMO_MODE=true
