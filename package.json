{
  "name": "chargeconnect",
  "version": "0.1.0",
  "private": true,
  "description": "Community EV charging availability and reservation platform",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./client --filter ./server dev",
    "dev:client": "pnpm --dir client dev",
    "dev:server": "pnpm --dir server dev",
    "build": "pnpm --filter ./client build && pnpm --filter ./server build",
    "lint": "pnpm --filter ./client lint && pnpm --filter ./server lint",
    "typecheck": "pnpm --filter ./client typecheck && pnpm --filter ./server typecheck",
    "test": "pnpm --filter ./server test",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:status": "supabase status"
  }
}
